<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShiftCalendar" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_turquoise</item>
        <item name="colorPrimaryDark">@color/amoled_black</item>
        <item name="colorAccent">@color/selected_blue</item>
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="android:statusBarColor">@color/amoled_black</item>
        <item name="android:navigationBarColor">@color/amoled_black</item>
        <item name="android:textColorPrimary">@color/text_white</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans-serif</item>

        <!-- Тёмная тема для диалогов (всегда тёмная) -->
        <item name="alertDialogTheme">@style/AppDialogTheme</item>
        <item name="android:datePickerDialogTheme">@style/AppDatePickerTheme</item>
    </style>

    <style name="AppDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@color/surface_dark</item>
        <item name="android:textColorPrimary">@color/text_white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorPrimary">@color/accent_turquoise</item>
        <item name="colorOnSurface">@color/text_white</item>
    </style>

    <style name="AppDatePickerTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:textColorPrimary">@color/text_white</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorPrimary">@color/accent_turquoise</item>
    </style>
</resources>
